# Protección contra intentos de acceso repetidos
[DEFAULT]
backend  = systemd
findtime = 10m
bantime  = 1h
maxretry = 5

[sshd]
enabled  = true
backend  = systemd
maxretry = 5
findtime = 10m
bantime  = 1h

# Reincidentes: bloqueo largo
[recidive]
enabled   = true
backend   = auto
logpath   = /var/log/fail2ban.log
banaction = %(banaction_allports)s
findtime  = 1d
maxretry  = 3
bantime   = 1w
