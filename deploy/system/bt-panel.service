[Unit]
Description=Panel de administración de Balón Turbo
After=network.target

[Service]
Type=simple
User=bt-panel
Group=bt-panel
EnvironmentFile=/etc/balon-turbo/bt.env
EnvironmentFile=/etc/balon-turbo/panel.env
ExecStart=/usr/bin/node /opt/balon-turbo/panel/server.js
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUQuota=50%
# NoNewPrivileges debe ser false: el panel usa «sudo -n bt-ctl panel ...» (setuid)
# y con NoNewPrivileges=true sudo no podría elevar privilegios.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# sudo necesita escribir sus marcas de tiempo en /run/sudo y /var/lib/sudo
ReadWritePaths=-/run/sudo -/var/lib/sudo
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
